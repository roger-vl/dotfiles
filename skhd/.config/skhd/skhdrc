# Default mode
:: default : echo -n "quit" | nc -4u -w0 localhost 1738
:: windows : ANYBAR_PORT=1738 ANYBAR_INIT=red open -na AnyBar
:: ress : ANYBAR_PORT=1738 ANYBAR_INIT=blue open -na AnyBar


# arrow movement
ctrl - h [
  *         : skhd -k "left"
  "ghostty" ~
]
ctrl - n [
  *         : skhd -k "down"
  "ghostty" ~
]
ctrl - p [
  *         : skhd -k "up"
  "ghostty" ~
]
ctrl - l [
  *         : skhd -k "right"
  "ghostty" ~
]


alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - h : yabai -m window --focus west
alt - l : yabai -m window --focus east

# #                       --grid <rows>:<cols>:<start-x>:<start-y>:<width>:<height>
alt - i : yabai -m window --toggle float --grid 24:24:1:1:22:22
alt - u : yabai -m window --toggle float --grid 24:24:2:2:20:20
alt - m : yabai -m window --toggle zoom-fullscreen

alt - n ; windows
# meh - o ; windows

# change window focus within space
windows < escape ; default
# ress < escape ; default
# <M-C-S-L>

#windows
#  resize
windows < shift - h : yabai -m window --resize right:-30:0 2> /dev/null || yabai -m window --resize left:-30:0 2> /dev/null
windows < shift - j : yabai -m window --resize bottom:0:20 2> /dev/null || yabai -m window --resize top:0:20 2> /dev/null
windows < shift - k : yabai -m window --resize bottom:0:-20 2> /dev/null || yabai -m window --resize top:0:-20 2> /dev/null
windows < shift - l : yabai -m window --resize right:30:0 2> /dev/null || yabai -m window --resize left:30:0 2> /dev/null
#  swap
windows <  j : yabai -m window --swap south 
windows <  k : yabai -m window --swap north 
windows <  h : yabai -m window --swap west 
windows <  l : yabai -m window --swap east 
# move and split
windows < ctrl - j : yabai -m window --warp south
windows < ctrl - k : yabai -m window --warp north
windows < ctrl - h : yabai -m window --warp west
windows < ctrl - l : yabai -m window --warp east

# example with escape
# windows < ctrl - l : yabai -m window --swap east && skhd -k "escape"
# #move window to prev and next space
# ctrl + alt - p : yabai -m window --space prev --focus
# ctrl + alt - y : yabai -m window --space next --focus

shift  + alt - y : yabai -m window --space prev; yabai -m space --focus prev
shift + alt - p : yabai -m window --space next; yabai -m space  --focus next
alt - y : yabai -m space --focus prev
alt - p : yabai -m space --focus next
