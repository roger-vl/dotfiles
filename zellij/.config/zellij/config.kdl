theme "gruvbox-dark"
// session_serialization false
on_force_close "quit"
simplified_ui true
pane_frames false
show_startup_tips false
// keybinds {
keybinds clear-defaults=true {
    shared_except "session" "locked" {
        bind "Super o" { SwitchToMode "Session"; }
    }
    session {
      bind "Esc" { SwitchToMode "Normal"; }
      bind "Ctrl s" { SwitchToMode "Scroll"; }
      bind "w" {
                  LaunchOrFocusPlugin "session-manager" {
                      floating true
                      move_to_focused_tab true
                  };
                  SwitchToMode "Normal"
              }
      bind "c" {
                  LaunchOrFocusPlugin "configuration" {
                      floating true
                      move_to_focused_tab true
                  };
                  SwitchToMode "Normal"
              }
          }
    normal {
        // bind "Super c" { Copy; }
        // bind "Super Alt Left" { GoToPreviousTab; }
        // bind "Super Alt Right" { GoToNextTab; }
        // bind "Super w" { CloseTab; }
        // bind "Super n" { NewTab; }
        // bind "Super t" { NewTab; }
        bind "Super p" { LaunchOrFocusPlugin "file:~/.config/zellij/plugins/zellij-choose-tree.wasm" {
                    floating true
                    move_to_focused_tab true
                    show_plugins false
                }; SwitchToMode "Normal";
              }
    }
}

// default_shell "fish"

// compact-bar location="zellij:compact-bar" { // <== comment out this line
// // compact-bar location="zellij:compact-bar" { // replace it with these lines
// //     tooltip "F1" // choose a keybinding to toggle the hints
// }
default_layout "dudecompact" // make sure this is set so you'll get the compact-bar instead of the default UI

copy_command "pbcopy"
copy_on_select true

